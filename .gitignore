# Data and outputs
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep

# Tuning trial results tracked - small, human-readable JSON, meant to be merged
# across teammates via git (see src/tuning.py). Everything else under data/processed/
# (raw split indices, dense feature caches, etc.) stays ignored above.
!data/processed/tuning_trials/
!data/processed/tuning_trials/*.json

# Out-of-fold ensemble member scores, tracked for the same reason: 16000 float32
# values is 64 KB per member, so three teammates can each generate different
# members in parallel and 10_stacked_ensemble picks them all up after a git pull.
!data/processed/oof/
!data/processed/oof/*.npy

models/*
!models/.gitkeep

submissions/*
!submissions/.gitkeep

reports/figures/*
!reports/figures/.gitkeep

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.ipynb_checkpoints/

# Environment / OS
.env
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/

CLAUDE.md
.claude