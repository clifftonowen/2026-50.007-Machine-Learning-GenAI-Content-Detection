# Data and outputs
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep

# Tuning trial results tracked - small, human-readable JSON, meant to be merged
# across teammates via git (see src/tuning.py). Everything else under data/processed/
# (raw split indices, dense feature caches, etc.) stays ignored above.
!data/processed/tuning_trials/
!data/processed/tuning_trials/*.json

# Out-of-fold ensemble member scores, tracked for the same reason: 16000 float32
# values is 64 KB per member, so teammates can each generate different members in
# parallel and 10_stacked_ensemble picks them all up after a git pull.
!data/processed/oof/
!data/processed/oof/*.npy

# Combiner results from the four ensembling lanes, same merge-by-git protocol as
# the tuning trials above (see src/combiners.py). One small JSON per combiner
# config, so four people sweep different lanes in parallel without ever editing
# the same file.
!data/processed/ensemble_trials/
!data/processed/ensemble_trials/*.json

models/*
!models/.gitkeep

submissions/*
!submissions/.gitkeep

# Report and deck live outside the repo (Google Doc / Slides). The build scripts,
# generated .docx/.pptx and figures are all local working files, not submission
# artifacts, so the whole folder stays out of git.
reports/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
.venv*/
venv/
.ipynb_checkpoints/

# Environment / OS
.env
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/

CLAUDE.md
.claude
